# Copy to `.env` and fill in. Names only — never commit real values.
# `.env` is gitignored; `.env.example` is the only env file that is tracked.

# --- Core ---
DATABASE_URL=
# Directory holding the synced config copies (defaults to ./config)
JOBPILOT_CONFIG_DIR=
LOG_LEVEL=

# --- API ---
# Bearer token guarding /api/status and /api/applications (/api/health stays open)
JOBPILOT_API_TOKEN=
# Target for scripts/keep-alive.ts
JOBPILOT_HEALTH_URL=

# --- Config sync (scripts/sync-config.ts) ---
# Path to the OS repo checkout; defaults to ~/dev/olaniyigeorge.os
JOBPILOT_OS_REPO=

# --- Google (feature-flagged off until the OAuth code exchange is done) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
JOBPILOT_ENABLE_GMAIL=false
JOBPILOT_ENABLE_SHEETS=false

# --- Notifications ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Safety ---
# Real submissions additionally require a logged approval; see PRODUCTION_PLAN §3
ALLOW_SUBMIT=false
