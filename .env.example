# Copy to `.env` and fill in. Names only — never commit real values.
# `.env` is gitignored; `.env.example` is the only env file that is tracked.

# --- Core ---
DATABASE_URL=
# Directory holding the synced config copies (defaults to ./config)
JOBPILOT_CONFIG_DIR=
LOG_LEVEL=

# --- API ---
# Bearer token guarding the dashboard data APIs (/api/health stays open)
JOBPILOT_API_TOKEN=
# Target for scripts/keep-alive.ts
JOBPILOT_HEALTH_URL=

# --- Config sync (scripts/sync-config.ts) ---
# Path to the OS repo checkout; defaults to ~/dev/olaniyigeorge.os
JOBPILOT_OS_REPO=

# --- Google (optional; enable only after OAuth consent) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_REDIRECT_URI=http://localhost
GOOGLE_SHEET_ID=
GOOGLE_SHEET_NAME=Sheet1
JOBPILOT_ENABLE_GMAIL=false
JOBPILOT_ENABLE_SHEETS=false

# --- Notifications ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Application drafts ---
JOBPILOT_CV_BASE_PATH=
JOBPILOT_ARTIFACTS_DIR=
