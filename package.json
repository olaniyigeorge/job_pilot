{
  "name": "job_pilot",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "description": "The Job Automation System aims to reduce the repetitive work by creating a centralized automation layer for job discovery and application workflows.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "pipeline": "tsx scripts/run-pipeline.ts",
    "config:sync": "tsx scripts/sync-config.ts",
    "keep-alive": "tsx scripts/keep-alive.ts",
    "automation:discover": "tsx scripts/discover-jobs.ts",
    "postinstall": "prisma skills sync || exit 0",
    "contract:emit": "prisma contract emit"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/olaniyigeorge/job_pilot.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/olaniyigeorge/job_pilot/issues"
  },
  "homepage": "https://github.com/olaniyigeorge/job_pilot#readme",
  "dependencies": {
    "@prisma/orm-postgres": "^8.0.0-rc.17",
    "dotenv": "^17.4.2",
    "next": "^16.4.0",
    "pino": "^10.4.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@prisma/cli-engine": "^0.7.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^10.12.0",
    "pino-pretty": "^13.2.0",
    "prettier": "^3.9.9",
    "prisma": "^8.0.0-rc.22",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3"
  }
}
